# Google Sheets and Drive server-side integration
GOOGLE_SHEETS_ID=1vjKrwmlUnaTpgtQl7hKddhAJhfMsV436xfklJ6_UxEw
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Base64-encoded service-account JSON. Share the spreadsheet and Drive folder
# with the service-account email before enabling write operations.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Internal authentication (server-only; never expose these values to the browser)
HACKATHON_AUTH_EMAIL=you@example.com
HACKATHON_AUTH_PASSWORD=
HACKATHON_AUTH_SECRET=
